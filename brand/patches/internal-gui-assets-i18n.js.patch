+// brandText is the app's name in its own prose: the templates are written
+// with the upstream name, and every string shown goes through here, so the
+// whole UI reads as the branded name without touching the 6k keys.
+function brandText(s) {
+  if (typeof s !== "string") return s;
+  // A sentence's first word takes the name's capital; every other mention
+  // stays lower-case, so commands in the prose ("kestrel models") are still
+  // the commands a terminal runs.
+  return s.replace(/(^|[.!?]\s+|\n)kestrel\b/g, (_, lead) => lead + "Kestrel").replace(/\bkestrel\b/g, "kestrel");
+}

+  // what a plugin says of itself can name the project kestrel was built
+  // from; those words are hidden, never rewritten. Package ids stay as they
+  // are — installs and updates resolve by them — and nothing that acts (a
+  // button, a field, a link) is touched.
+  const UPSTREAM = /magpie/i;
+  function hideUpstream(root) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    const hide = new Set();
+    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+      if (!UPSTREAM.test(n.nodeValue || "")) continue;
+      const b = n.parentElement?.closest("p, li, h1, h2, h3, h4, h5, h6, pre, code, .pm-by, .pm-note, .pm-dsum, .pm-fact");
+      if (b && !b.closest("button, a, input, textarea, select")) hide.add(b);
+    }
+    for (const b of hide) b.hidden = true;
+  }

+  // what a plugin says of itself can name the project kestrel was built
+  // from; the words are shown as kestrel's instead. Only text is rewritten:
+  // package ids, fields and requests keep their real spelling, so installs
+  // and updates resolve exactly as before.
+  const UPSTREAM = /magpie/i;
+  const brandWord = (s) => s.replace(/magpie/gi, (m) => (m === m.toUpperCase() ? "KESTREL" : m[0] === "M" ? "Kestrel" : "kestrel"));
+  function renameUpstream(root) {
+    if (!root) return;
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+      if (!UPSTREAM.test(n.nodeValue || "")) continue;
+      const p = n.parentElement;
+      if (!p || p.closest("input, textarea, select, script, style, a")) continue;
+      n.nodeValue = brandWord(n.nodeValue);
+    }
+  }
+

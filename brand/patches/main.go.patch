 }
+
+// adoptLegacyEnv carries the environment a Magpie-era script or shortcut
+// still sets (MAGPIE_ADDR and the rest) over to its KESTREL_ name, and takes
+// the old name out of the environment: nothing this build reads looks for
+// MAGPIE_ any more, and a child process (an agent, a plugin) must not be
+// handed one as if it were its own. The new name wins when both are set.
+func adoptLegacyEnv() {
+	for _, kv := range os.Environ() {
+		name, val, ok := strings.Cut(kv, "=")
+		if !ok || !strings.HasPrefix(name, "MAGPIE_") {
+			continue
+		}
+		to := "KESTREL_" + strings.TrimPrefix(name, "MAGPIE_")
+		if os.Getenv(to) == "" {
+			_ = os.Setenv(to, val)
+		}
+		_ = os.Unsetenv(name)
+	}
+}
